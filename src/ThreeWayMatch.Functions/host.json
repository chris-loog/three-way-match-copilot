{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request;Exception"
      }
    }
  },
  "extensions": {
    "queues": {
      "messageEncoding": "none",
      "maxDequeueCount": 5,
      "batchSize": 1,
      "newBatchThreshold": 0,
      "visibilityTimeout": "00:00:30"
    }
  }
}
